# Database
DATABASE_URL="postgresql://user:password@localhost:5432/school_management"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_NAME="School Management System"

# Rotina diária (POST /api/cron/daily, header x-cron-secret)
CRON_SECRET="troque-por-um-segredo-longo"

# Notificações: "console" (padrão, só registra no log) ou "smtp"
NOTIFICATION_DRIVER="console"
# Necessários apenas com NOTIFICATION_DRIVER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Escola D'Ávilla <nao-responda@exemplo.com.br>"
SMTP_SECURE="false"
