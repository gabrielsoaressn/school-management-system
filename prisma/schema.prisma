// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS EXISTENTES (com atualizações)
// ============================================

enum UserRole {
  ADMIN
  PARENT
  STUDENT
  TEACHER
  SECRETARY
  COORDINATOR
  FINANCE
  /// Employee with a login but no portal access (support staff).
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  DRAFT
  PENDING
  /// Some payments received, still short of the full amount.
  PARTIALLY_PAID
  PAID
  OVERDUE
  RENEGOTIATED
  CANCELLED
}

enum PaymentMethod {
  PIX
  BOLETO
  CARD
  CASH
  TRANSFER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EmployeeType {
  TEACHER
  COORDINATOR
  ADMINISTRATIVE
  MAINTENANCE
  CLEANING
  CLASSROOM_ASSISTANT
  HALLWAY_ASSISTANT
  PSYCHOLOGIST
  PRINCIPAL
  STAFF
  ADMIN
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum BillingType {
  TUITION
  MATERIAL
  EVENT
  OTHER
}

enum RecurrenceType {
  NONE
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum AcademicYearStatus {
  /// Being set up: classes and staffing defined, enrolments not open yet.
  PLANNING
  /// In progress. Exactly one year is ACTIVE and isCurrent at a time.
  ACTIVE
  /// Finished. Kept for history; nothing new is written against it.
  CLOSED
}

enum EnrollmentStatus {
  ACTIVE
  /// Finished the year and was promoted.
  COMPLETED
  /// Finished the year and was held back.
  RETAINED
  /// Left the school during the year.
  TRANSFERRED
  CANCELLED
}

enum PayrollStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ============================================
// 🆕 NOVOS ENUMS - MÓDULOS AVANÇADOS
// ============================================

enum EnrollmentRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum GuardianType {
  FINANCIAL // Responsável Financeiro
  PEDAGOGICAL // Responsável Pedagógico
  BOTH // Ambos
}

enum ReminderType {
  EMAIL
  WHATSAPP
  SMS
  SYSTEM
}

enum ReminderStatus {
  SENT
  DELIVERED
  FAILED
  OPENED
}

enum OccurrenceType {
  BEHAVIORAL // Comportamento
  ACADEMIC // Acadêmico
  HEALTH // Saúde
  ATTENDANCE // Frequência
  POSITIVE // Elogio/Reconhecimento
  OTHER
}

enum OccurrenceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  ENROLLMENT_DECLARATION // Declaração de Matrícula
  SERVICE_CONTRACT // Contrato de Prestação de Serviços
  ACADEMIC_TRANSCRIPT // Histórico Escolar
  CONDUCT_CERTIFICATE // Atestado de Conduta
  ENROLLMENT_CERTIFICATE // Certificado de Matrícula
  CUSTOM // Personalizado
}

// ============================================
// MODELOS PRINCIPAIS (Core)
// ============================================

// Core User Model
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  role      UserRole
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Accounts created by the school start with a temporary password.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // Relations
  student             Student?
  parent              Parent?
  employee            Employee?
  accounts            Account[]
  sessions            Session[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([role])
}

// Student Model
model Student {
  id        String @id @default(cuid())
  studentId String @unique
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         Gender
  address        String
  phoneNumber    String?
  enrollmentDate DateTime @default(now())
  profilePhoto   String?

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id])

  // Relations existentes
  enrollments Enrollment[]
  reports     AcademicReport[]

  // 🆕 Novos relacionamentos - Módulos Avançados
  enrollmentRequest     EnrollmentRequest?
  guardianRelationships GuardianRelationship[]
  assessments           Assessment[]
  attendanceRecords     AttendanceRecord[]
  occurrences           Occurrence[]
  generatedDocuments    GeneratedDocument[]

  /// Soft delete: personal and financial records are never hard deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([parentId])
  @@index([deletedAt])
}

// Parent Model
model Parent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phoneNumber String
  address     String
  occupation  String?
  cpf         String? @unique
  email       String?

  // 🆕 Novo campo - Módulo 3
  whatsappNumber String?

  // Relations existentes
  students Student[]
  billings Billing[]

  // 🆕 Novos relacionamentos - Módulos Avançados
  guardianRelationships GuardianRelationship[]
  financialContacts     FinancialContact[]

  /// Soft delete: personal and financial records are never hard deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpf])
  @@index([deletedAt])
}

// Employee Model
model Employee {
  id         String @id @default(cuid())
  employeeId String @unique
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  phoneNumber  String
  address      String
  employeeType EmployeeType
  position     String
  department   String?
  salary       Decimal      @db.Decimal(10, 2)
  hireDate     DateTime     @default(now())
  profilePhoto String?
  cpf          String?      @unique
  pixKey       String?
  bankName     String?
  bankAgency   String?
  bankAccount  String?

  // Relations
  teacher  Teacher?
  payrolls Payroll[]

  /// Soft delete: personal and financial records are never hard deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([employeeType])
  @@index([cpf])
  @@index([deletedAt])
}

// Teacher Model (extends Employee)
model Teacher {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  qualification  String
  specialization String
  experience     Int // years of experience

  // Relations existentes
  subjects TeacherSubject[]

  // 🆕 Novos relacionamentos - Módulo 2
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]
  classAssignments  ClassSubjectTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// Subject Model
model Subject {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  gradeLevel  String
  creditHours Int     @default(3)

  // Relations existentes
  teachers TeacherSubject[]

  // 🆕 Novos relacionamentos - Módulo 2
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]
  classAssignments  ClassSubjectTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gradeLevel])
  @@index([code])
}

// Teacher-Subject Assignment (Many-to-Many)
model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

/// The school year. Everything academic — a class, an enrolment, a grade, a
/// register entry — belongs to exactly one of these, so "3º Ano" is always a
/// statement about a particular year.
model AcademicYear {
  id        String             @id @default(cuid())
  year      Int                @unique
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  /// Exactly one row is true; enforced by a partial unique index.
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(PLANNING)

  classes           Class[]
  enrollments       Enrollment[]
  assignments       ClassSubjectTeacher[]
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isCurrent])
  @@index([status])
}

// Class Model
/// A classroom in a given year: "6º Ano A / 2026". Not subject-specific — the
/// curriculum lives in ClassSubjectTeacher.
model Class {
  id             String       @id @default(cuid())
  name           String
  gradeLevel     String
  section        String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  roomNumber     String?
  schedule       String?
  capacity       Int?

  enrollments Enrollment[]
  assignments ClassSubjectTeacher[]

  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeLevel, section, academicYearId])
  @@index([academicYearId])
  @@index([gradeLevel, section])
}

/// Who teaches which subject in which class, for a given year. This is the
/// curriculum of a class, and the only thing that authorizes a teacher to enter
/// grades or attendance for it.
model ClassSubjectTeacher {
  id             String       @id @default(cuid())
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  /// Weekly periods, for timetable and workload reports.
  weeklyPeriods Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicYearId])
}

// Enrollment Model (Student-Class relationship)
/// A student's placement for one school year. This — not Student — is where the
/// grade level lives: a student is in 3º Ano *in 2026*, and in 4º Ano in 2027.
///
/// `gradeLevel` and `section` are copied from the class on creation and kept in
/// step by src/lib/enrollment.ts, which is the only place that writes them. The
/// copy is deliberate: a report card, a transcript and the promotion routine all
/// ask "which grade was this student in, that year?", and that must survive the
/// class being renamed or the student moving section.
model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  gradeLevel     String
  section        String
  status         EnrollmentStatus @default(ACTIVE)

  enrolledAt DateTime  @default(now())
  /// Set when the year closes or the student leaves.
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One placement per student per year.
  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
  @@index([gradeLevel, section])
  @@index([status])
}

// ============================================
// FINANCEIRO (Existente)
// ============================================

// Billing Model (Contas a Receber)
model Billing {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  parentId        String
  parent          Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  type            BillingType
  description     String
  amount          Decimal        @db.Decimal(10, 2)
  dueDate         DateTime
  paidDate        DateTime?
  status          PaymentStatus  @default(PENDING)
  isRecurring     Boolean        @default(false)
  recurrence      RecurrenceType @default(NONE)
  nextBillingDate DateTime?
  paymentMethod   String?
  transactionId   String?
  notes           String?

  // 🆕 Novos relacionamentos - Módulo 3
  reminders      PaymentReminder[]
  renegotiations PaymentRenegotiation[]
  /// Receipts against this charge. `status` is derived from their sum.
  payments       Payment[]

  /// Soft delete: personal and financial records are never hard deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([deletedAt])
}

// Payroll Model (Folha de Pagamento)
model Payroll {
  id             String        @id @default(cuid())
  paymentId      String        @unique
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary     Decimal       @db.Decimal(10, 2)
  bonus          Decimal       @default(0) @db.Decimal(10, 2)
  deductions     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  referenceMonth Int
  referenceYear  Int
  status         PayrollStatus @default(SCHEDULED)
  scheduledDate  DateTime
  paidDate       DateTime?
  paymentMethod  String?
  transactionId  String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, referenceMonth, referenceYear])
  @@index([employeeId])
  @@index([status])
  @@index([scheduledDate])
}

// Expense Model
model Expense {
  id            String   @id @default(cuid())
  category      String
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  date          DateTime
  paymentMethod String?
  receiptUrl    String?
  approvedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// ============================================
// ACADÊMICO (Existente)
// ============================================

// Academic Report Model
model AcademicReport {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  term              String
  academicYear      String
  overallGrade      String
  gpa               Float
  attendance        Float // percentage
  teacherComments   String?
  principalComments String?
  reportUrl         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, term, academicYear])
  @@index([studentId])
}

// ============================================
// COMUNICAÇÃO (Existente)
// ============================================

// Announcement Model
model Announcement {
  id            String    @id @default(cuid())
  title         String
  content       String
  targetRole    String? // null = all, or specific role
  targetGrade   String? // null = all grades
  priority      String    @default("normal") // low, normal, high
  expiresAt     DateTime?
  attachmentUrl String?
  createdBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([targetRole])
}

// Notification Model
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String
  type      String // payment, grade, announcement, etc.
  isRead    Boolean @default(false)
  actionUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

// Settings Model (System Configuration)
model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String
  type  String @default("text") // text, number, boolean, json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================
// 🆕 MÓDULO 1: MATRÍCULA DIGITAL
// ============================================

model EnrollmentRequest {
  id            String                  @id @default(cuid())
  requestNumber String                  @unique
  status        EnrollmentRequestStatus @default(PENDING)

  // Dados do Aluno
  studentFirstName String
  studentLastName  String
  dateOfBirth      DateTime
  gender           Gender
  gradeLevel       String
  section          String?

  // Dados do Responsável Financeiro
  financialGuardianFirstName String
  financialGuardianLastName  String
  financialGuardianCPF       String
  financialGuardianPhone     String
  financialGuardianEmail     String

  // Dados do Responsável Pedagógico
  pedagogicalGuardianFirstName String?
  pedagogicalGuardianLastName  String?
  pedagogicalGuardianCPF       String?
  pedagogicalGuardianPhone     String?
  pedagogicalGuardianEmail     String?
  isSameGuardian               Boolean @default(false)

  // Endereço
  address String
  city    String
  state   String
  zipCode String

  // Documentos anexos
  birthCertificateUrl String?
  cpfUrl              String?
  proofOfAddressUrl   String?
  previousSchoolUrl   String?

  // Consentimento LGPD (art. 7º, I e V): registrado com data e versão do texto
  consentGivenAt DateTime?
  consentVersion String?

  // Campos administrativos
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  notes           String?

  // Relacionamento com aluno criado
  approvedStudentId String?  @unique
  approvedStudent   Student? @relation(fields: [approvedStudentId], references: [id])

  /// Soft delete: personal and financial records are never hard deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestNumber])
  @@index([createdAt])
  @@index([deletedAt])
}

model GuardianRelationship {
  id           String       @id @default(cuid())
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId     String
  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  guardianType GuardianType
  isPrimary    Boolean      @default(false)
  canPickup    Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, parentId, guardianType])
  @@index([studentId])
  @@index([parentId])
}

// ============================================
// 🆕 MÓDULO 2: GESTÃO ACADÊMICA
// ============================================

model AssessmentType {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  weight      Float   @default(1.0)
  maxScore    Float   @default(10.0)
  description String?

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Assessment {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          Teacher?       @relation(fields: [teacherId], references: [id])
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  term           String
  score          Float
  maxScore       Float        @default(10.0)
  grade          String?
  remarks        String?
  assessmentDate DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, assessmentTypeId, term, academicYearId])
  @@index([studentId])
  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
  @@index([academicYearId, term])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?         @relation(fields: [subjectId], references: [id])
  teacherId      String?
  teacher        Teacher?         @relation(fields: [teacherId], references: [id])
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One register entry per student per class per day. Deliberately not keyed on
  /// subjectId: it is nullable, and Postgres treats NULLs as distinct, which
  /// would let the same day be recorded twice.
  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([academicYearId])
  @@index([date])
}

// ============================================
// 🆕 MÓDULO 3: FINANCEIRO AVANÇADO
// ============================================

model PaymentReminder {
  id             String         @id @default(cuid())
  billingId      String
  billing        Billing        @relation(fields: [billingId], references: [id], onDelete: Cascade)
  reminderType   ReminderType
  status         ReminderStatus @default(SENT)
  recipientName  String
  recipientEmail String?
  recipientPhone String?
  subject        String?
  message        String
  templateUsed   String?
  sentAt         DateTime       @default(now())
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingId])
  @@index([status])
  @@index([sentAt])
}

model PaymentRenegotiation {
  id                 String    @id @default(cuid())
  billingId          String
  billing            Billing   @relation(fields: [billingId], references: [id], onDelete: Cascade)
  originalAmount     Decimal   @db.Decimal(10, 2)
  renegotiatedAmount Decimal   @db.Decimal(10, 2)
  discount           Decimal   @default(0) @db.Decimal(10, 2)
  installments       Int       @default(1)
  newDueDate         DateTime
  renegotiatedBy     String
  parentApprovedAt   DateTime?
  reason             String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingId])
  @@index([createdAt])
}

model FinancialContact {
  id              String  @id @default(cuid())
  parentId        String
  parent          Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  contactType     String
  name            String
  email           String?
  phoneNumber     String
  whatsappNumber  String?
  preferredMethod String  @default("EMAIL")
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([contactType])
}

// ============================================
// 🆕 MÓDULO 4: PORTAL DE COMUNICAÇÃO
// ============================================

model Occurrence {
  id             String             @id @default(cuid())
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           OccurrenceType
  severity       OccurrenceSeverity
  title          String
  description    String
  reportedBy     String
  reportedByName String
  date           DateTime           @default(now())
  actionTaken    String?
  parentNotified Boolean            @default(false)
  parentViewedAt DateTime?
  parentComments String?
  attachmentUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([type])
  @@index([severity])
  @@index([date])
}

model CommunicationThread {
  id            String   @id @default(cuid())
  subject       String
  senderId      String
  senderName    String
  senderRole    String
  recipientId   String
  recipientName String
  recipientRole String
  lastMessageAt DateTime @default(now())
  isArchived    Boolean  @default(false)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([recipientId])
  @@index([lastMessageAt])
}

model Message {
  id            String              @id @default(cuid())
  threadId      String
  thread        CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String
  senderName    String
  content       String
  isRead        Boolean             @default(false)
  readAt        DateTime?
  attachmentUrl String?

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================
// 🆕 MÓDULO 5: GERADOR DE DOCUMENTOS
// ============================================

model DocumentTemplate {
  id                 String       @id @default(cuid())
  name               String
  type               DocumentType
  description        String?
  htmlTemplate       String
  availableVariables String
  isActive           Boolean      @default(true)

  generatedDocuments GeneratedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model GeneratedDocument {
  id            String           @id @default(cuid())
  templateId    String
  template      DocumentTemplate @relation(fields: [templateId], references: [id])
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type          DocumentType
  generatedHtml String
  pdfUrl        String?
  generatedBy   String
  generatedAt   DateTime         @default(now())
  metadata      String?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([type])
  @@index([generatedAt])
}

// ============================================
// NEXTAUTH MODELS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Password reset tokens. Only the SHA-256 hash is stored, so a dump of this
/// table cannot be replayed against an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// LGPD: AUDITORIA E DIREITOS DO TITULAR
// ============================================

/// Append-only trail of privileged operations. Never updated, never deleted by
/// the application: retention is an operational decision (docs/OPERATIONS.md).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

enum DataSubjectRequestType {
  ACCESS
  DELETION
  CORRECTION
  PORTABILITY
}

enum DataSubjectRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

/// LGPD art. 18 requests (access, deletion, correction, portability) filed by
/// the data subject or their guardian.
model DataSubjectRequest {
  id             String                   @id @default(cuid())
  protocol       String                   @unique
  type           DataSubjectRequestType
  status         DataSubjectRequestStatus @default(RECEIVED)
  requesterName  String
  requesterEmail String
  requesterCpf   String?
  studentName    String?
  description    String
  response       String?
  handledBy      String?
  handledAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status])
  @@index([protocol])
  @@index([createdAt])
}

/// A payment received against a charge. Partial payments are the norm in a
/// school, so Billing.status is derived from the sum of these rows rather than
/// being set by hand.
model Payment {
  id         String        @id @default(cuid())
  billingId  String
  billing    Billing       @relation(fields: [billingId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(10, 2)
  paidAt     DateTime      @db.Date
  method     PaymentMethod
  /// Staff member who registered a manual payment.
  receivedBy String?
  /// Identifier from the payment provider; unique so a replayed webhook is a
  /// no-op instead of a duplicate receipt.
  externalId String?       @unique
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([billingId])
  @@index([paidAt])
}
